{
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "defaultTools": ["+codemode"],
  "codemode": {
    "mode": "only",
    "inlineBudget": 500
  },
  "packages": [
    "npm:@notrico/pi-fold",
    "npm:pi-web-access",
    "npm:@gotgenes/pi-anthropic-auth"
  ],
  "hideThinkingBlock": true,
  "quietStartup": "header",
  "warnings": {
    "anthropicExtraUsage": false
  },
  "theme": "frappe"
}
