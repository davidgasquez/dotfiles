diff --git a/src/tray.rs b/src/tray.rs
new file mode 100644
index 0000000..f500232
--- /dev/null
+++ b/src/tray.rs
@@ -0,0 +1,196 @@
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Mutex, OnceLock};
+use std::time::{Duration, Instant};
+
+use async_channel::Sender;
+use ksni::blocking::TrayMethods;
+use serde_json::{Value, json};
+
+use crate::mods::Request;
+
+static READY: AtomicBool = AtomicBool::new(false);
+static HIDDEN: AtomicBool = AtomicBool::new(false);
+static STARTUP_CANCELLED: AtomicBool = AtomicBool::new(false);
+static VISIBILITY: Mutex<()> = Mutex::new(());
+static HANDLE: OnceLock<ksni::blocking::Handle<Tray>> = OnceLock::new();
+
+struct Tray {
+    requests: Sender<Request>,
+    online: AtomicBool,
+}
+
+impl Tray {
+    fn show(&self) {
+        let (reply, _) = std::sync::mpsc::channel();
+        let _ = self.requests.try_send(Request::Control {
+            cmd: json!({"raise": true}),
+            reply,
+        });
+    }
+}
+
+impl ksni::Tray for Tray {
+    fn id(&self) -> String {
+        "herdr-app".into()
+    }
+    fn title(&self) -> String {
+        "Herdr".into()
+    }
+    fn icon_name(&self) -> String {
+        "@icon@".into()
+    }
+
+    fn activate(&mut self, _: i32, _: i32) {
+        self.show();
+    }
+    fn secondary_activate(&mut self, _: i32, _: i32) {
+        self.show();
+    }
+
+    fn menu(&self) -> Vec<ksni::MenuItem<Self>> {
+        use ksni::menu::StandardItem;
+        vec![
+            StandardItem {
+                label: "Show Herdr".into(),
+                activate: Box::new(|tray: &mut Self| tray.show()),
+                ..Default::default()
+            }
+            .into(),
+            StandardItem {
+                label: "Quit".into(),
+                activate: Box::new(|tray: &mut Self| {
+                    let _ = tray.requests.try_send(Request::Run {
+                        name: "app.quit".into(),
+                        args: Value::Null,
+                    });
+                }),
+                ..Default::default()
+            }
+            .into(),
+        ]
+    }
+
+    fn watcher_online(&self) {
+        self.online.store(true, Ordering::SeqCst);
+        READY.store(true, Ordering::SeqCst);
+    }
+
+    fn watcher_offline(&self, _: ksni::OfflineReason) -> bool {
+        self.online.store(false, Ordering::SeqCst);
+        READY.store(false, Ordering::SeqCst);
+        if HIDDEN.load(Ordering::SeqCst) {
+            self.show();
+        }
+        true
+    }
+}
+
+pub fn start(requests: Sender<Request>) {
+    if std::env::var_os("HYPRLAND_INSTANCE_SIGNATURE").is_none() {
+        return;
+    }
+    let start_hidden = std::env::var("HERDR_START_HIDDEN").as_deref() == Ok("1");
+    let deadline = Instant::now() + Duration::from_secs(3);
+    std::thread::spawn(move || {
+        match (Tray {
+            requests,
+            online: AtomicBool::new(true),
+        })
+        .assume_sni_available(true)
+        .spawn()
+        {
+            Ok(handle) => {
+                handle.update(|tray| {
+                    READY.store(tray.online.load(Ordering::SeqCst), Ordering::SeqCst)
+                });
+                let _ = HANDLE.set(handle);
+                // A mapping failure leaves the app visible, never closed. Late watchers don't hide it.
+                if start_hidden {
+                    while Instant::now() < deadline
+                        && !STARTUP_CANCELLED.load(Ordering::SeqCst)
+                    {
+                        if READY.load(Ordering::SeqCst) {
+                            if hide_window(true) {
+                                if STARTUP_CANCELLED.load(Ordering::SeqCst) {
+                                    show();
+                                }
+                                break;
+                            }
+                        }
+                        std::thread::sleep(Duration::from_millis(200));
+                    }
+                    cancel_startup_hide();
+                }
+            }
+            Err(error) => tracing::warn!("system tray unavailable; close will quit: {error}"),
+        }
+    });
+}
+
+pub fn cancel_startup_hide() {
+    STARTUP_CANCELLED.store(true, Ordering::SeqCst);
+}
+
+fn hyprctl(args: &[&str]) -> Option<String> {
+    let output = crate::spawn::command("@timeout@")
+        .args(["1", "@hyprctl@"])
+        .args(args)
+        .output()
+        .ok()?;
+    output
+        .status
+        .success()
+        .then(|| String::from_utf8_lossy(&output.stdout).trim().to_owned())
+}
+
+pub fn hide() -> bool {
+    cancel_startup_hide();
+    hide_window(false)
+}
+
+fn hide_window(startup: bool) -> bool {
+    let _visibility = VISIBILITY.lock().unwrap();
+    if !READY.load(Ordering::SeqCst) || (startup && STARTUP_CANCELLED.load(Ordering::SeqCst)) {
+        return false;
+    }
+    let workspace = format!("special:herdr-{}", std::process::id());
+    let command = format!(
+        "hl.dsp.window.move({{ window = \"pid:{}\", workspace = \"{}\", follow = false }})",
+        std::process::id(),
+        workspace
+    );
+    let hidden = hyprctl(&["dispatch", &command]).as_deref() == Some("ok")
+        && hyprctl(&["-j", "clients"])
+            .and_then(|clients| serde_json::from_str::<Vec<Value>>(&clients).ok())
+            .is_some_and(|clients| clients.iter().any(|window| {
+                window["pid"].as_u64() == Some(u64::from(std::process::id()))
+                    && window["workspace"]["name"].as_str() == Some(workspace.as_str())
+            }));
+    HIDDEN.store(hidden, Ordering::SeqCst);
+    if hidden && !READY.load(Ordering::SeqCst) {
+        drop(_visibility);
+        show();
+        return false;
+    }
+    hidden
+}
+
+pub fn show() {
+    cancel_startup_hide();
+    let _visibility = VISIBILITY.lock().unwrap();
+    if !HIDDEN.load(Ordering::SeqCst) {
+        return;
+    }
+    let command = format!(
+        "hl.dsp.window.move({{ window = \"pid:{}\", workspace = hl.get_active_workspace() }})",
+        std::process::id()
+    );
+    if hyprctl(&["dispatch", &command]).as_deref() == Some("ok") {
+        HIDDEN.store(false, Ordering::SeqCst);
+        let command = format!(
+            "hl.dsp.focus({{ window = \"pid:{}\" }})",
+            std::process::id()
+        );
+        let _ = hyprctl(&["dispatch", &command]);
+    }
+}
