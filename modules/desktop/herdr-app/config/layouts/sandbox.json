{
  "id": "root",
  "terminal_menu": "conversation-menu",
  "cloned_from": {
    "name": "my-layout",
    "version": "0.1.11"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "sandbox-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-toolbar",
          "type": "block",
          "content": {
            "mod": "sandbox-toolbar"
          },
          "size": {
            "px": 32
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "sandbox-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "sandbox-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "sandbox-pane"
                    },
                    "reveal": "hover",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 0,
                    "color": "border"
                  },
                  "focus": {
                    "width": 0,
                    "color": "accent"
                  },
                  "radius": 0,
                  "gap": 0,
                  "lone": false
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "sandbox-changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 0,
          "gap": 0
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "background",
  "terminal_padding": [
    10,
    5
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
